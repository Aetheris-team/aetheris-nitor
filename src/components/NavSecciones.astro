---
interface Enlace {
  href: string;
  etiqueta: string;
}

interface Props {
  etiqueta: string;
  enlaces: Enlace[];
  class?: string;
}

const { etiqueta, enlaces, class: clasePersonalizada = 'mb-6' } = Astro.props;
---

<nav
  class:list={['flex flex-wrap gap-2 font-sans text-sm', clasePersonalizada]}
  aria-label={etiqueta}
  data-nav-secciones
>
  {
    enlaces.map((enlace) => (
      <a
        href={enlace.href}
        class="inline-flex min-h-[44px] items-center rounded-full border border-border bg-surface px-3 py-1.5 transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        {enlace.etiqueta}
      </a>
    ))
  }
</nav>

<script>
  document.addEventListener('keydown', (evento) => {
    const enlaceActual = evento.target as HTMLElement | null;
    if (!enlaceActual || !enlaceActual.matches('[data-nav-secciones] a'))
      return;

    const nav = enlaceActual.closest('[data-nav-secciones]');
    if (!nav) return;

    const enlaces = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    if (enlaces.length === 0) return;

    const indice = enlaces.indexOf(enlaceActual as HTMLAnchorElement);
    if (indice === -1) return;

    let nuevoIndice = -1;
    if (evento.key === 'ArrowRight' || evento.key === 'ArrowDown') {
      nuevoIndice = (indice + 1) % enlaces.length;
    } else if (evento.key === 'ArrowLeft' || evento.key === 'ArrowUp') {
      nuevoIndice = (indice - 1 + enlaces.length) % enlaces.length;
    } else if (evento.key === 'Home') {
      nuevoIndice = 0;
    } else if (evento.key === 'End') {
      nuevoIndice = enlaces.length - 1;
    }

    if (nuevoIndice !== -1) {
      evento.preventDefault();
      enlaces[nuevoIndice]?.focus();
    }
  });
</script>
