{
  "name": "aetheris-web",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{astro,js,ts}\" \"tests/**/*.{js,ts}\" \"*.{js,mjs,ts}\"",
    "format": "prettier --write \"src/**/*.{astro,js,ts,css}\" \"tests/**/*.{js,ts}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,js,ts,css}\" \"tests/**/*.{js,ts}\" \"*.{js,mjs,ts,json}\"",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "chroma-js": "^3.2.0",
    "echarts": "^6.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/tabler": "^1.2.42",
    "@playwright/test": "^1.64.1",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^26.6.5",
    "astro-icon": "^1.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.7"
    }
  }
}
